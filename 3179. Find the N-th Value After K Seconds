Question link:- https://leetcode.com/problems/find-the-n-th-value-after-k-seconds/?slug=find-the-n-th-value-after-k-seconds&region=global_v2

class Solution {
public:
    int valueAfterKSeconds(int n, int k) {
        vector<int> arr(n, 1);
        int mod = 1e9+7;
        k = k-1;
        while(k){
            for(int i=1; i<n; i++) arr[i] = (arr[i] + arr[i-1])%mod;
            k--;
        }
        int sum = 0;
        for(const auto & it : arr) sum = (sum + it)%mod;
        return sum;
    }
};
