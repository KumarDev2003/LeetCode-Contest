class DSU{
public:
vector<int> parent;
vector<int> rank;
DSU(int n){
    rank.resize(n, 0);
    parent.resize(n);
    for(int i=0; i<n; i++){
        parent[i] = i;
    }
}
int find(int x){
    if(x == parent[x]) return x;
    return parent[x] = find(parent[x]);
}
void insert(int u, int v){
    int pu = find(u);
    int pv = find(v);
    if(pu == pv) return;
    if(rank[pu] == rank[pv]){
        parent[pv] = pu;
        rank[pu]++;
    }else if(rank[pu] > rank[pv]){
        parent[pv] = pu;
    }else{
        parent[pu] = pv;
    }
}
};
class Solution {
public:
    bool intersect(auto& a, auto& b, int& k){
        int n = a.size();
        int i = 0;
        int j = 0;
        int prev = -1;
        int cnt = 0;
        while(i < n && j < n){
            if(a[i] == prev){
                i++;
                continue;
            }
            if(b[j] == prev){
                j++;
                continue;
            }
            if(a[i] == b[j]){
                cnt++;
                prev = a[i];
                i++;
                j++;
            }else if(a[i] < b[j]){
                i++;
            }else{
                j++;
            }
        }
        return cnt >= k;
    }
    int numberOfComponents(vector<vector<int>>& properties, int k) {
        int n = properties.size();
        DSU d(n);
        for(auto& it : properties) sort(it.begin(), it.end());
        for(int i=0; i<n; i++){
            for(int j=i+1; j<n; j++){
                if(intersect(properties[i], properties[j], k)){
                    d.insert(i, j);
                }
            }
        }
        for(auto& it : d.parent){
            it = d.find(it);
        }
        unordered_set<int> st;
        for(auto& it : d.parent){
            st.insert(it);
        }
        return st.size();
    }
};
